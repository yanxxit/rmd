{
  "name": "@yanit/rmd",
  "version": "0.1.20",
  "description": "A fast cross-platform file/directory removal tool written in Rust — a rimraf alternative",
  "keywords": [
    "rimraf",
    "remove",
    "delete",
    "rm",
    "rmdir",
    "recursive",
    "cross-platform",
    "rust",
    "cli"
  ],
  "license": "MIT",
  "author": "yanxxit",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanxxit/rmd"
  },
  "homepage": "https://github.com/yanxxit/rmd#readme",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "rmd": "bin/rmd.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "bin",
    "*.node"
  ],
  "engines": {
    "node": ">= 14"
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js",
    "build:debug": "napi build --platform --js native.js",
    "build:all": "node scripts/build-all.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test": "node test/index.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  }
}
